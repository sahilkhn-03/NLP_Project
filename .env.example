# Optional: set this to your OpenAI-compatible API key to enable LLM fallback.
# Leave blank (or remove) to use only the local rule-based engine.
# IMPORTANT: Never commit a real key. Add .env to your .gitignore.
OPENAI_API_KEY=

# Optional: change the model used for LLM-based SQL generation (requires API key above)
LLM_MODEL=gpt-3.5-turbo

# Optional: override the default database file path
# DB_PATH=data/school.db
